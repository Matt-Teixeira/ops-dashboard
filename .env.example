# ops-dashboard — copy to .env and fill in (.env is gitignored).
# Mirrors the suite's PG env convention (see docs/infra-conventions.md).

APP_NAME=ops-dashboard

# --- HTTP server ---
PORT=8080

# --- PostgreSQL (read-only over util.app_run_logs) ---
# In-network the DB is reachable at pg_db:5432. From the host it's localhost:5432.
# Connect as the dedicated least-privilege role, NOT a superuser. Create it once
# with db/setup-readonly-role.sql (it has only CONNECT + USAGE + SELECT).
PGHOST=pg_db
PGPORT=5432
PGUSER=ops_dashboard_ro
PGPASSWORD=__set_me__
PGDATABASE=      # REQUIRED: <DB_NAME> per the setup doc identity table (dev / staging / prod)
PG_SSLMODE=require                       # disable | require | verify-full
PG_SSL_PATH=/opt/resources/ssl/pg_ssl.crt

# --- Dashboard tuning ---
# Error-feed lookback window, in days (partition-pruned on inserted_at).
ERRORS_LOOKBACK_DAYS=2
# Job grid: served from an in-process incremental cache. A job is shown iff its
# last run is within the retention window (dormant jobs stay visible as stale
# within it, then age out). The grid bootstraps once over this window on boot,
# then ticks incrementally every GRID_REFRESH_MS, re-scanning SUMMARY_OVERLAP_MS
# behind the watermark each tick to absorb insert-lag skew. Every
# SUMMARY_RECONCILE_MS a tick instead does a full retention re-scan, so any
# late/backfilled insert older than the overlap is still picked up.
SUMMARY_RETENTION_DAYS=30
SUMMARY_OVERLAP_MS=300000
SUMMARY_RECONCILE_MS=21600000
GRID_REFRESH_MS=120000
# Per-app run-log view (Phase 11): the default lookback window (hours) and page
# size for GET /api/apps/:app/runs. Direct, partition-pruned, not cached. The
# window is clamped 1..720h and the limit 1..500 per request. Exception: the
# data_acquisition page size is fixed at 50 (default and max) -- its pages carry
# the Phase 18 verbose_log job-type extraction, so the page size is the detoast
# ceiling (Phase 19 Codex review). This knob does not apply to that app.
APP_RUNS_LOOKBACK_HOURS=24
APP_RUNS_LIMIT=200
# Per-app recent-run health (Phase 12): window (hours) for the per-app runs/errored/
# warned counts shown on the grid's app group header. Cheap warn_error_logs-only
# aggregate computed on the grid refresh timer; additive to /api/jobs/latest.
APP_HEALTH_WINDOW_HOURS=24
# Per-system acquisition view (Phase 15): default window (hours) for
# GET /api/acquisition/systems over stats.acquisition_history (BRIN-bounded on
# inserted_at; clamped 1..720). Requires the stats grant in db/setup-readonly-role.sql.
ACQ_WINDOW_HOURS=24
# Per-system correlation view (Phase 17): default window (hours) for GET /api/systems
# and GET /api/systems/:id -- the cross-app per-equipment (note.sme) warn/error rollup.
# warn_error_logs-only (no verbose_log detoast), partition-pruned; clamped 1..48
# (request AND env default -- 168h measured 2.3s warm, over the request-path budget;
# 24h ~0.4s, 48h ~0.8s; Phase 19 Codex review). No extra grant (reads util + alert).
SYSTEMS_WINDOW_HOURS=24

# --- Self-monitoring (Phase 7) ---
# Opt-in. When true, the serve process writes a heartbeat run (app_name=ops-dashboard)
# every SELF_LOG_INTERVAL_MS via a locked-down writer role, so the dashboard appears in
# its own grid. Off keeps the app fully read-only. Requires the writer role + function
# from db/setup-writer-role.sql, and the separate writer credential below.
SELF_LOG_ENABLED=false
SELF_LOG_INTERVAL_MS=300000
PG_WRITER_USER=ops_dashboard_rw
PG_WRITER_PASSWORD=__set_me__

# ---------------------------------------------------------------------------
# RELEASE OVERRIDE CONVENTION
# Lines prefixed `#RELEASE:KEY=VALUE` are applied by build-release.sh to the
# COPIED .env in /opt/apps/ops-dashboard: the active KEY= line is replaced and
# the markers stripped. The dev tree keeps both lines as one source of truth.
# Only IDENTITY belongs here (USER_ID, COMPOSE_PROJECT_NAME, HOST_PORT);
# environment properties (PG*, ports of shared services) get NO override —
# they describe the server, not the release.
# ---------------------------------------------------------------------------

# --- Identity (dev vs release) ---
# USER_ID drives the image tag (ops-dashboard:${USER_ID}) and the build LABEL.
# Dev = your host username; the release copy gets svc via the #RELEASE: line.
USER_ID=          # REQUIRED: your host username, e.g. matt-teixeira
#RELEASE:USER_ID=svc

# Compose project name. The dev clone and /opt/apps/ops-dashboard share a dir
# basename, hence the same default compose project — a dev `up -d` would
# otherwise RECREATE the production container. Compose fails safe to the dev
# value when this key is missing.
COMPOSE_PROJECT_NAME=ops-dashboard-dev
#RELEASE:COMPOSE_PROJECT_NAME=ops-dashboard

# Published host port (container listens on PORT=8080 either way). Fails safe
# to 8081 so a dev `up` can never shadow the production :8080.
HOST_PORT=8081
#RELEASE:HOST_PORT=8080

# Do NOT set RUN_USER here: entrypoint.sh defaults to svc (production), and
# dev runs pass it on the command line (RUN_USER=<you> docker compose ...).

# --- Docker build args (host identity facts; no #RELEASE: — same on both) ---
# staging: DOCKER_GID=987 UID_0=105 (svc). UID_1 = your host UID (id -u).
DOCKER_GID=       # REQUIRED
UID_0=            # REQUIRED
UID_1=            # REQUIRED

# RELEASE_SHA is injected into the DEPLOYED .env by build-release.sh — never
# set it by hand; a dev tree has no key and records "dev-tree" instead.
